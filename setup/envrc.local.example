# Copy to /home/mohan/tts/.envrc.local on the host and fill in real values.
# Bare KEY=value lines (no `export`) so direnv (`dotenv`) and systemd
# (`EnvironmentFile=`) can both read the same file.

TTS_PROVIDER=qwen
DASHSCOPE_API_KEY=
TTS_MODEL=qwen3-tts-instruct-flash-realtime
OCR_PROVIDER=qwen
OCR_MODEL=qwen-vl-ocr
QWEN_REALTIME_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
TTS_DEFAULT_ENGLISH_VOICE=Kai
TTS_DEFAULT_CHINESE_VOICE=Cherry
TTS_DATA_DIR=/home/mohan/tts/data
TTS_SEGMENT_MAX_CHARS=550

# Qwen request limits in seconds (finite and positive).
export QWEN_SETUP_TIMEOUT_SECONDS=15
export QWEN_AUDIO_TIMEOUT_SECONDS=60
export QWEN_SEGMENT_TIMEOUT_SECONDS=180
